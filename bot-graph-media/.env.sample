# =============================================================================
# Azure AD Configuration
# =============================================================================
# Get these from Azure Portal → App Registrations → Your App
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# =============================================================================
# Bot Configuration
# =============================================================================
BOT_NAME=RecordingBot
BOT_DISPLAY_NAME=Meeting Recorder

# Public URL where your bot is accessible (ngrok or Azure App Service)
# This must be HTTPS and publicly accessible for Microsoft callbacks
BOT_PUBLIC_URL=https://your-domain.ngrok.io

# =============================================================================
# Certificate Configuration (Optional - use client secret OR certificate)
# =============================================================================
# For production, use certificate authentication (more secure)
# Generate with: dotnet dev-certs https -ep certificate.pfx -p YourPassword
CERTIFICATE_PATH=./certificate.pfx
CERTIFICATE_PASSWORD=YourSecurePassword

# =============================================================================
# Microsoft Graph API
# =============================================================================
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
NOTIFICATION_URL=https://your-domain.ngrok.io/api/notifications

# =============================================================================
# Media Server Configuration
# =============================================================================
# Port for receiving RTP media streams
MEDIA_INSTANCE_INTERNAL_PORT=8445
MEDIA_INSTANCE_PUBLIC_PORT=8445

# Your public domain/IP (same as BOT_PUBLIC_URL without https://)
SERVICE_FQDN=your-domain.ngrok.io

# =============================================================================
# Recording Output
# =============================================================================
OUTPUT_PATH=./output/recordings
TEMP_PATH=./output/temp

# =============================================================================
# Webhook Notifications (Optional)
# =============================================================================
# Get a free URL from https://webhook.site for testing
WEBHOOK_URL=https://webhook.site/your-unique-id

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=Information
LOG_FILE_PATH=./logs/bot.log
